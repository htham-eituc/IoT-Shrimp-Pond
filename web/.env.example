# Authentication always uses Firebase Email/Password and validates /users/{uid}.
# Pond data remains independently selectable; mock is the default when omitted.
VITE_DATA_MODE=mock

# Required in both data modes. Copy this file to .env and fill values locally.
# Never put a farmer email/password, token, or other secret in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
