# Choose one data source. Mock is the safe default when this variable is omitted.
VITE_DATA_MODE=mock

# Required only when VITE_DATA_MODE=firebase.
# Copy this file to .env and replace placeholders locally. Never commit real values.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://replace-with-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
