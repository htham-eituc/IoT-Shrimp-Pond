# Authentication uses Firebase Email/Password and validates /users/{uid}.
# All dashboard data is read from and written to Firebase Realtime Database.
# Copy this file to .env and fill values locally.
# Never put a farmer email/password, token, or other secret in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public OAuth Web client ID. Enable Gmail API and add this site's origin to
# the client's Authorized JavaScript origins. No client secret belongs here.
VITE_GOOGLE_GMAIL_CLIENT_ID=

# Optional MQTT live-sensor overlay. Required in both configuration modes.
VITE_MQTT_WSS_URL=

# HiveMQ Serverless/demo mode. This account must be subscribe-only for the
# single pond topic. VITE_ values are shipped to every browser, so do not use a
# credential with publish or broad topic permissions here.
VITE_MQTT_DASHBOARD_USERNAME=
VITE_MQTT_DASHBOARD_PASSWORD=

# Production mode instead of the dashboard credentials above. This endpoint
# verifies the Firebase ID token and returns short-lived, pond-scoped MQTT
# credentials. Do not configure both modes.
VITE_MQTT_CREDENTIAL_ENDPOINT=
